# URL del backend (Railway)
VITE_API_URL=https://tu-api.up.railway.app

# Mercado Pago — solo la Public Key va aquí (el Access Token va como secreto en el backend)
VITE_MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# URL del webhook del chatbot (n8n)
VITE_N8N_CHAT_URL=https://tu-n8n.example.com/webhook/chat-ecommerce

# Webhooks de emails transaccionales (n8n)
VITE_N8N_BIENVENIDA_URL=https://tu-n8n.example.com/webhook/bienvenida
VITE_N8N_CARRITO_URL=https://tu-n8n.example.com/webhook/carrito-abandonado
VITE_N8N_COMPRA_EXITOSA_URL=https://tu-n8n.example.com/webhook/compra-exitosa
VITE_N8N_COMPRA_FALLIDA_URL=https://tu-n8n.example.com/webhook/compra-fallida

# Secreto compartido con n8n (mismo valor que la variable de entorno WEBHOOK_SECRET
# configurada en la instancia de n8n) para que los webhooks de emails transaccionales
# rechacen llamadas que no vengan de este frontend.
VITE_N8N_WEBHOOK_SECRET=cambiar-por-un-valor-largo-y-aleatorio
